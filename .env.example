NODE_ENV=development
PORT=3000

# Required in production
JWT_SECRET=replace-with-a-long-random-secret
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Recommended in production
DEFAULT_ADMIN_EMAIL=owner@example.com
DEFAULT_ADMIN_NAME=Academy Admin
DATABASE_URL=mysql://user:password@host:3306/database

# Optional depending on your OAuth setup
VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional platform-specific values
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional bulk SMS delivery
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
